datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Project {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String
  techStack   String[]
  githubUrl   String?
  projectUrl  String?
  createdAt   DateTime @default(now())
}
