---
import ProjectsApp from "@/components/ProjectsApp";
import "@/styles/global.css";

// ProjectsApp fetches /api/projects after hydration, so nothing per-request belongs in this
// frontmatter. A prisma call here would bake a snapshot into the static output.
export const prerender = true;
---

<!doctype html>
<html lang="en" class="no-scrollbar">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Konichiwa - Things I've Built</title>
  </head>
  <body class="bg-[#f7f7f8] text-neutral-900 font-['Plus_Jakarta_Sans',sans-serif] no-scrollbar">
    <ProjectsApp client:load />
  </body>
</html>
